# Образ API для выкладки. Локальный compose собирает backend/Dockerfile (context ./backend).
# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm

ARG SOFTGEN_BUILD_REV=dev
LABEL softgen.build_rev=$SOFTGEN_BUILD_REV

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PATH="/usr/local/bin:$PATH"

WORKDIR /app

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin appuser

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml backend/README.md backend/alembic.ini ./

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip \
    && pip install .

COPY backend/alembic ./alembic
COPY backend/app ./app
COPY backend/scripts ./scripts

USER appuser

EXPOSE 8000

CMD ["sh", "-c", "python -m alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
