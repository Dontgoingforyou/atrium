# Скопировать в `.env` для `npm run dev` (файл в .gitignore).
# Образ Docker web собирается из корня репозитория — там VITE_* задаются build-args compose, не этот файл.

# Префикс API (совпадает с proxy в vite.config.ts → бэкенд :9062)
VITE_API_BASE=/api/v1

# OAuth callback: localhost, чтобы совпало с Valid redirect URIs в Keycloak
VITE_SPA_REDIRECT_URI=http://localhost:5173/auth/callback
