# Локальный запуск. Скопировать в .env и подставить свои значения.
# .env в git не коммитится.

# ---------- Frontend (build arg образа web) ----------
VITE_SPA_REDIRECT_URI=http://localhost:9088/auth/callback
VITE_JIRA_BASE_URL=

# ---------- База данных (стенд stand/docker-compose.yml уже задаёт dev/dev) ----------
# DATABASE_URL=postgresql+asyncpg://dev:dev@127.0.0.1:5435/cosmolet

# ---------- API ----------
APP_NAME=Cosmolet API
DOCS_ENABLED=true
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:9088,http://127.0.0.1:9088

# Секрет cookie /admin. Сгенерировать: openssl rand -hex 32
ADMIN_SESSION_SECRET=заменить-локальный-секрет

# REDIS_PASSWORD=
# FORWARDED_ALLOW_IPS=127.0.0.1

# ---------- SSO (пусто — вход через шлюз не настроен) ----------
SSO_SERVICE_URL=
SSO_API_PREFIX=/api/
SSO_AUTH_PAGE_PATH=/auth
SSO_TOKEN_PATH=auth/oauth2/token
SSO_REFRESH_PATH=auth/refresh
SSO_USERINFO_PATH=auth/me
SSO_LOGIN_PATH=auth/login
SSO_LOGOUT_PATH=auth/logout
SSO_SCOPES=openid profile email
SSO_GROUPS_CLAIM=groups
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_CLIENT_ID_5173=
SSO_CLIENT_SECRET_5173=
SSO_CLIENT_ID_9088=
SSO_CLIENT_SECRET_9088=
SSO_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/callback,http://127.0.0.1:5173/auth/callback,http://localhost:9088/auth/callback,http://127.0.0.1:9088/auth/callback

# ---------- Jira (пусто — интеграция выключена) ----------
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_BOARD_ID=0
JIRA_PERSONAL_ACCESS_TOKEN=
JIRA_WEBHOOK_SECRET=
JIRA_TASKS_PROJECT_KEY=
JIRA_TASKS_BOARD_ID=0
JIRA_TASKS_SYNC_ENABLED=false
JIRA_TASKS_ISSUE_TYPE=Задача

# ---------- MinIO (локальный стенд: minioadmin / minioadmin) ----------
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9063
MINIO_INTERNAL_SECURE=false
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chat-attachments

# ---------- Telegram (без токена бот не стартует) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
PORTAL_PUBLIC_URL=http://localhost:9088
TELEGRAM_USE_POLLING=true
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_PATH=/tg/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PROXY_URL=

# ---------- Календарь и почта (опционально) ----------
CALENDAR_SERVICE_URL=
CALENDAR_PRODUCT=cosmolet
CALENDAR_KAFKA_BOOTSTRAP_SERVERS=
CALENDAR_KAFKA_TOPIC=calendar
CALENDAR_KAFKA_GROUP=cosmolet-calendar
# SMTP_ENABLED=false
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# ---------- Прочее ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
