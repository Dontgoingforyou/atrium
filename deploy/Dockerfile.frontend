# Softgen stand-host: context = ./project/frontend, dockerfile = ./deploy/Dockerfile.frontend
# (путь dockerfile относительно корня бандла; context — только frontend).
# syntax=docker/dockerfile:1
FROM node:22-bookworm AS build

WORKDIR /app
ARG VITE_BASE=/
ENV VITE_BASE=$VITE_BASE
ARG VITE_SPA_REDIRECT_URI=
ENV VITE_SPA_REDIRECT_URI=${VITE_SPA_REDIRECT_URI}

COPY package.json package-lock.json .npmrc ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci
COPY . .
RUN npm run build -- --base ${VITE_BASE}

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# SPA fallback: Softgen монтирует nginx.conf из deploy при наличии
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
