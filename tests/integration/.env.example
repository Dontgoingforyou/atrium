# Локальные секреты для make test-integration (файл не коммитить).
# Скопируйте: cp tests/integration/.env.example tests/integration/.env
#
# APP_BASE_URL — тот же URL, что открываете в браузере:
#   Docker-шлюз (канон локально): http://127.0.0.1:9088
#   только Vite:                  http://127.0.0.1:5173

APP_BASE_URL=http://127.0.0.1:9088
E2E_SSO_USER_EMAIL=
# Пароль со спецсимволами (# { } и т.д.) — обязательно в кавычках:
# E2E_SSO_USER_PASSWORD='часть#с-решёткой'
E2E_SSO_USER_PASSWORD=

# Опционально, если SSO поднят отдельно:
# SSO_BASE_URL=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
